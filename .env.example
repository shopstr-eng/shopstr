# Database connection string
# For local development with docker-compose:
DATABASE_URL=postgresql://shopstr:shopstr@localhost:5432/shopstr

# Controls whether Testcontainers-based integration tests run.
# Set to exactly `1` to enable tests guarded by RUN_TESTCONTAINERS (requires Docker).
# Example: RUN_TESTCONTAINERS=1
#
# When enabled, some integration tests will start a real Postgres container
# via Testcontainers. Only enable in environments with Docker available.
RUN_TESTCONTAINERS=0

# Required for MCP agent onboarding when Shopstr stores encrypted nsec values
MCP_ENCRYPTION_KEY=replace-with-a-long-random-secret

# Optional: override the public base URL used in MCP onboarding responses
# NEXT_PUBLIC_BASE_URL=https://shopstr.example

# from request headers if NEXT_PUBLIC_BASE_URL is not set
# MCP_ALLOWED_HOSTS=shopstr.example,api.shopstr.example

# Optional: trust X-Forwarded-For for rate limiting only when requests always
# pass through a reverse proxy that appends the real client IP.
# TRUST_PROXY_HEADERS=true
#
# Alternative: trust forwarded headers only from these direct proxy IPs.
# TRUSTED_PROXY_IPS=127.0.0.1,::1

# For production, use your actual database URL:
# DATABASE_URL=postgresql://user:password@host:port/database

# Shopstr-controlled arbiter Cashu pubkey (32-byte hex) for 2-of-3 dispute escrow.
NEXT_PUBLIC_ARBITER_PUBKEY=replace-with-32-byte-hex-cashu-pubkey

# Arbiter's Nostr identity pubkey (hex) — distinct from the Cashu P2PK
# pubkey above. Routes escrow-dispute DMs and gates /disputes + its controls.
NEXT_PUBLIC_ARBITER_NOSTR_PUBKEY=replace-with-arbiter-nostr-pubkey-hex

# Optional server-only copy of the arbiter Nostr pubkey. If unset, the API
# uses NEXT_PUBLIC_ARBITER_NOSTR_PUBKEY as the public identifier.
# ARBITER_NOSTR_PUBKEY=replace-with-arbiter-nostr-pubkey-hex

# Arbiter's Nostr identity PRIVATE key (hex or nsec), server-only. Signs the
# NIP-59 seal on outgoing escrow-arbiter-sig DMs, and decrypts the NIP-59
# gift-wrapped hodl escrow disputes that /api/lightning/resolve-hodl-dispute
# has to read before an arbiter ruling may move money — without it that route
# answers 503, since it cannot tell "no dispute" from "cannot look". This is a
# different key from ARBITER_PRIVKEY below — do not confuse the two.
ARBITER_NOSTR_PRIVKEY=replace-with-arbiter-nostr-privkey-hex-or-nsec

# Arbiter's Cashu P2PK signing key (hex), server-only. Produces the
# arbiter's P2PK signature share when resolving a 2-of-3 dispute.
ARBITER_PRIVKEY=replace-with-arbiter-cashu-privkey-hex

# Enable Lightning escrow only after configuring LND and the Nostr arbiter.
# NEXT_PUBLIC_HODL_ESCROW_ENABLED=true
# HODL_INVOICE_PROVIDER=lnd

# Authenticated recovery endpoint for hosts that sleep or scale to zero.
# CRON_SECRET=replace-with-a-long-random-secret

# Connection details for HODL_INVOICE_PROVIDER=lnd. All three are required.
# LND_HOST is host:port for the node's gRPC listener; the other two are the
# node's tls.cert and a macaroon (GetInfo, AddHoldInvoice, LookupInvoiceV2,
# SettleInvoice, CancelInvoice) as lowercase hex:
#   xxd -p -c 100000 /path/to/tls.cert | tr -d '\n'
#   xxd -p -c 100000 /path/to/invoice.macaroon | tr -d '\n'
# The macaroon can move funds out of escrow - treat it as a secret.
# LND_HOST=127.0.0.1:10009
# LND_TLS_CERT_HEX=replace-with-hex-encoded-tls-cert
# LND_INVOICE_MACAROON_HEX=replace-with-hex-encoded-invoice-macaroon
#
# Optional: directory holding lightning.proto, invoices.proto, and
# router.proto. Defaults to utils/lightning/lnd-proto, which is what a normal
# deployment wants.
# LND_PROTO_DIR=utils/lightning/lnd-proto

# Sends settled escrow funds on to the seller (utils/lightning/hodl-seller-
# payout.ts, via lnd-payment-client.ts): SendPaymentV2 to pay out, TrackPaymentV2
# to check a payment already sent. Real payouts require HODL_INVOICE_PROVIDER=lnd.
# Reuses LND_HOST/LND_TLS_CERT_HEX above, but needs
# its own macaroon, scoped to exactly those two RPCs (not admin, not even
# info:read - the opt-in hodl-regtest test exercises this exact scope).
# Missing or invalid hex fails each payout attempt (recorded and retried),
# not the whole process; until it's set, payouts stay owed and findable via
# the hodl_escrow_payouts table. The server retries and the UI shows payout status.
#   xxd -p -c 100000 /path/to/payment.macaroon | tr -d '\n'
# This macaroon can move funds out of escrow - treat it as a secret.
# LND_PAYMENT_MACAROON_HEX=replace-with-hex-encoded-payment-macaroon

# Explicit allowlist for Cashu mints that can be used for P2PK escrow checkout
# and server-side arbiter dispute signing. Required by the arbiter API before it
# will load the token's mint.
# NEXT_PUBLIC_P2PK_ESCROW_ALLOWED_MINTS=https://mint.example

# Local E2E only: lets /api/cashu/validate-mint accept local/private miant URLs
# (and non-standard ports) for fake-mint testing. Ignored when
# NODE_ENV=production — leave unset in any real deployment.
# CASHU_MINT_VALIDATION_ALLOW_LOCAL=false

# Required for HODL order registration and secret decryption (all environments).
# Generate 32 random bytes once, store securely, and retain it across deployments.
# Never prefix this with NEXT_PUBLIC_. Losing/changing it prevents settlement.
# HODL_ESCROW_ENCRYPTION_KEY=64-hex-characters
# Startup encrypts legacy plaintext preimages in place when this key is present.
# Existing database backups still contain old plaintext and need restricted access.
# Always-on LND servers reconcile status and payouts every 30 seconds. On hosts
# that sleep/scale to zero, schedule authenticated POST /api/lightning/sync-hodl-orders.
# Never delete/replace a recorded payout invoice to retry an unknown payment.

# Hold duration advertised in the invoice, in blocks (48–144; default 80).
# Final CLTV is distinct from the unpaid invoice's one-hour wall-clock expiry.
# HODL_HOLD_CLTV_DELTA=80
# Default: pickup/contact only. Shipping requires explicit opt-in and a workflow
# that completes delivery AND dispute resolution before the actual HTLC expires.
# NEXT_PUBLIC_HODL_ALLOW_SHIPPING=false
# Recovery: keep the Node server alive, or schedule authenticated POST requests
# to /api/lightning/sync-hodl-orders every 30 seconds with Bearer CRON_SECRET.
# Recovery verifies published confirmations/rulings and retries seller payouts.
