{
  "name": "@shopstr/mcp",
  "version": "0.1.0",
  "description": "Read-only MCP server for the Shopstr decentralized marketplace",
  "type": "module",
  "homepage": "https://github.com/shopstr-eng/shopstr/tree/main/packages/shopstr-mcp#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/shopstr-eng/shopstr.git",
    "directory": "packages/shopstr-mcp"
  },
  "bugs": {
    "url": "https://github.com/shopstr-eng/shopstr/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "bin": {
    "shopstr-mcp": "dist/index.js"
  },
  "exports": {
    ".": {
      "types": "./dist/server.d.ts",
      "import": "./dist/server.js"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "import": "./dist/server.js"
    }
  },
  "main": "./dist/server.js",
  "types": "./dist/server.d.ts",
  "files": [
    "dist",
    ".env.example",
    "README.md"
  ],
  "scripts": {
    "clean": "node scripts/clean-dist.mjs",
    "prebuild": "npm run clean && node scripts/sync-canonical-parser.mjs",
    "build": "tsc -p tsconfig.json",
    "prepack": "npm run build",
    "prepublishOnly": "npm test",
    "start": "node dist/index.js",
    "test": "npm run build && node --test test/*.node.mjs test/tools/*.node.mjs"
  },
  "engines": {
    "node": ">=22.4.0"
  },
  "keywords": [
    "shopstr",
    "mcp",
    "nostr",
    "bitcoin",
    "marketplace"
  ],
  "license": "GPL-3.0-only",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "nostr-tools": "2.23.9",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/node": "^25.8.0",
    "typescript": "^6.0.3"
  }
}
